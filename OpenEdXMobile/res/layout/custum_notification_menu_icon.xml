<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:id="@+id/custom_notification_bell_icon_relativeLayout"
    android:importantForAccessibility="yes"
    android:layout_height="wrap_content">

    <ImageButton
        android:id="@+id/bell_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:focusable="true"
        android:background="@color/white"
        android:scaleType="fitCenter"
        android:src="@drawable/baseline_notifications_vector_24"
        android:importantForAccessibility="no"
        android:contentDescription="@string/notification_button" />

    <TextView
        android:id="@+id/notification_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignRight="@id/bell_icon"
        android:layout_alignTop="@id/bell_icon"
        android:gravity="center"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="10sp"
        android:textStyle="bold"
        android:text="+5"
        android:importantForAccessibility="no"
        android:visibility="visible" />

</RelativeLayout>
