<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:textColor="@color/white" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout_status"
                android:layout_width="75dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                app:cardCornerRadius="5dp"
                android:background="@color/shimmer_placeholder"
                android:textColor="@color/organisation_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/shimmer_status"
                        android:layout_width="75dp"
                        android:layout_height="16dp"
                        android:textSize="10dp"
                        android:background="@color/shimmer_placeholder"
                        android:textColor="@color/organisation_color" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_course_status"
                android:layout_width="75dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="5dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ln_course_status"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/course_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10dp"
                        android:textColor="@color/seach_hint_color" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/course_card_not_enrolled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:padding="6dp"
            android:orientation="vertical"
            android:background="@drawable/course_card_enrolled">

            <TextView
                android:id="@+id/course_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:textStyle="bold"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/organisation_color" />

            <TextView
                android:id="@+id/course_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/seach_hint_color" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/course_card_enrolled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:padding="6dp"
            android:background="@drawable/course_card_enrolled">

            <LinearLayout
                android:id="@+id/course_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="80dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/course_name_enrolled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/organisation_color" />

                <TextView
                    android:id="@+id/course_language_enrolled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/seach_hint_color" />
            </LinearLayout>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout_view_button"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_margin="8dp"
                android:visibility="gone"
                android:background="@color/shimmer_placeholder"
                android:textColor="@color/organisation_color"
                android:textSize="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:padding="8dp"
                        android:textSize="12dp"
                        android:background="@color/shimmer_placeholder"
                        android:textColor="@color/organisation_color" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:layout_margin="8dp"
                android:orientation="vertical">
            <Button
                android:id="@+id/view_button"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/view"
                android:layout_marginEnd="10dp"
                android:padding="8dp"
                android:textSize="12dp"
                android:visibility="gone"
                android:textColor="@color/organisation_color"
                android:background="@drawable/bg_black_border" />

            <Button
                android:id="@+id/contnue_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="@string/continue_string"
                android:layout_marginEnd="10dp"
                android:padding="8dp"
                android:textSize="12dp"
                android:visibility="gone"
                android:textColor="@color/organisation_color"
                android:background="@drawable/bg_black_border" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</layout>
