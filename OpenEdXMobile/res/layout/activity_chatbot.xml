<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    android:theme="@style/AppTheme.NoActionBar"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/edx_white"
        android:backgroundTint="@color/edx_white">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:actionBarSize"
            android:layout_alignParentTop="true"
            android:animateLayoutChanges="true"
            android:background="@color/white"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/ThemeOverlay.AppCompat.Dark"
            app:titleTextColor="@color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/back_arrow"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="10dp"
                    android:contentDescription="@string/back"
                    android:visibility="visible"
                    android:elevation="2dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_arrow_back_24_black" />

                <ImageView
                    android:id="@+id/subodha_logo_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="50dp"
                    android:visibility="visible"
                    android:clipToOutline="true"
                    android:layout_centerVertical="true"
                    android:src="@mipmap/subodha_icon"
                    android:background="@drawable/circle_shape"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textviewChatbot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/back_arrow"
                android:layout_marginStart="50dp"
                android:layout_centerVertical="true"
                android:text="@string/subodha_ai"
                    android:textStyle="bold"
                android:textColor="@color/grey_text"
                android:textSize="20sp" />
            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>


    <FrameLayout
        android:id="@+id/main_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/input_layout"
        android:layout_below="@id/app_bar"
        android:background="@color/transparent"
        android:layout_marginBottom="80dp"
        android:padding="8dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
           />
    </FrameLayout>

    <FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:id="@+id/input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/transparent"
            android:paddingTop="22dp"
            android:paddingBottom="-4dp"
            android:paddingLeft="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:padding="8dp"
                android:background="@color/white"
                android:layout_gravity="center_vertical|end"
                android:layout_marginRight="70dp"
                android:layout_height="wrap_content">
            <EditText
                android:id="@+id/editTextMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_background"
                android:hint="@string/type_a_message"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:textColor="@color/grey_text"
                android:textColorHint="@color/hint_grey_text"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:layout_centerVertical="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceIconButtonLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/circle_background_blue"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="19dp"
           >

            <ImageButton
                android:id="@+id/voiceIconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:focusable="true"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:background="@drawable/circle_background_yellow_circle"
                android:scaleType="fitCenter"
                android:elevation="4dp"
                android:src="@drawable/baseline_keyboard_voice_24"
                android:contentDescription="@string/voice_menu_item" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical|end"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="19dp">
            <ImageButton
                android:id="@+id/buttonSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:focusable="true"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:elevation="4dp"
                android:contentDescription="@string/send_item"
                android:background="@drawable/circle_background_yellow_circle"
                android:src="@drawable/ic_send"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="85dp"
        android:contentDescription="@string/down"
        android:src="@drawable/baseline_keyboard_arrow_down_24"
        app:fabCustomSize="48dp"
        app:maxImageSize="24dp"
        app:backgroundTint="@color/transparent"
        android:visibility="gone" />



</RelativeLayout>
