<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/custom_shape.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Semicircle on the left -->
    <item
        android:left="0dp"
        android:right="20dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/browser_actions_divider_color"
                android:endColor="@color/continue_color"
                android:angle="45" />
        </shape>
    </item>

    <!-- Rounded rectangle on the right -->
    <item
        android:left="200dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/continue_color" />
            <corners
                android:topRightRadius="10dp"
                android:bottomRightRadius="10dp" />
        </shape>
    </item>

</layer-list>
